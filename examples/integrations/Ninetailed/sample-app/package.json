{
  "name": "ninetailed-sample-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "lint": "eslint --config eslint.config.js src",
    "preview": "vite preview",
    "clean": "rm -rf node_modules dist",
    "setup": "npm install",
    "setup:ci": "npm ci",
    "verify": "node ../../../utils/mock-servers/verify-with-mock.js .",
    "clean:fresh": "npm run clean && rm -rf package-lock.json"
  },
  "dependencies": {
    "@ninetailed/experience.js": "7.26.0",
    "@rudderstack/analytics-js": "*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "@faker-js/faker": "10.6.0",
    "zod": "4.6.7"
  }
}
