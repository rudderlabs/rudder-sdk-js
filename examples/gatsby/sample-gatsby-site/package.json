{
  "name": "sample-gatsby-site",
  "version": "1.0.0",
  "private": true,
  "description": "sample-gatsby-site",
  "author": "RudderStack",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "gatsby develop",
    "start": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "rm -rf node_modules public .cache",
    "setup": "npm install",
    "setup:ci": "npm ci",
    "verify": "node ../../utils/mock-servers/verify-with-mock.js .",
    "clean:fresh": "npm run clean && rm -rf package-lock.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rudderstack/analytics-js": "*",
    "dotenv": "18.0.8",
    "gatsby": "5.16.1",
    "gatsby-plugin-env-variables": "2.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "7.0.2"
  },
  "overrides": {
    "cookie": "0.7.0",
    "path-to-regexp": "0.1.13",
    "axios": {
      "form-data": "4.0.6"
    },
    "@graphql-tools/utils": "12.1.0",
    "immutable": "3.8.4",
    "lodash": "4.18.1",
    "serialize-javascript": "7.1.2",
    "sharp": "0.35.5",
    "tmp": "0.2.7",
    "webpack-dev-middleware": "7.4.6",
    "multer": "2.5.0"
  }
}
