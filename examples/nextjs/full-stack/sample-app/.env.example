# Server-side Node SDK configuration
RUDDERSTACK_WRITE_KEY=${WRITE_KEY}
RUDDERSTACK_DATAPLANE_URL=${DATAPLANE_URL}
# Set to true only for a trusted production demo.
RUDDERSTACK_ALLOW_SERVER_EVENTS_API=false

# Client-side JavaScript SDK configuration
NEXT_PUBLIC_RUDDERSTACK_WRITE_KEY=${WRITE_KEY}
NEXT_PUBLIC_RUDDERSTACK_DATAPLANE_URL=${DATAPLANE_URL}
NEXT_PUBLIC_RUDDERSTACK_CONFIG_URL=${CONFIG_SERVER_HOST}
