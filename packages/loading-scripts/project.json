{
  "name": "@rudderstack/analytics-js-loading-scripts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/loading-scripts/src",
  "projectType": "library",
  "tags": ["type:app", "scope:snippet"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/loading-scripts/jest.config.mjs",
        "passWithNoTests": true,
        "codeCoverage": false,
        "watchAll": false,
        "forceExit": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": false
        }
      },
      "dependsOn": ["test:build-core"],
      "inputs": [
        "test",
        "^default",
        "{projectRoot}/jest.global-setup.cjs",
        "{projectRoot}/rollup.config.mjs",
        "{projectRoot}/config/**/*",
        {
          "dependentTasksOutputFiles": "**/rsa.min.js",
          "transitive": false
        },
        {
          "env": "PINNED_CORE_DIR"
        },
        {
          "runtime": "node packages/loading-scripts/config/pinned-core.mjs"
        }
      ]
    },
    "test:build-core": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        {
          "projects": ["@rudderstack/analytics-js"],
          "target": "build:browser:dev"
        }
      ],
      "inputs": ["default", "^default"],
      "outputs": [
        "{workspaceRoot}/packages/analytics-js/dist/cdn/legacy",
        "{workspaceRoot}/packages/analytics-js/dist/cdn/modern"
      ],
      "options": {
        "commands": ["npm run build:browser", "npm run build:browser:modern"],
        "cwd": "packages/analytics-js",
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "hasTypeAwareRules": true,
        "lintFilePatterns": [
          "packages/loading-scripts/src/**/*.{ts,js}",
          "packages/loading-scripts/{package,project}.json"
        ]
      },
      "configurations": {
        "ci": {
          "force": true,
          "outputFile": "packages/loading-scripts/reports/eslint.json",
          "format": "json"
        }
      }
    },
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {
        "preset": "conventionalcommits",
        "tagPrefix": "{projectName}@"
      }
    },
    "github": {
      "executor": "@jscutlery/semver:github",
      "options": {
        "tag": "@rudderstack/analytics-js-loading-scripts@3.4.1",
        "title": "@rudderstack/analytics-js-loading-scripts@3.4.1",
        "discussion-category": "@rudderstack/analytics-js-loading-scripts@3.4.1",
        "notesFile": "./packages/loading-scripts/CHANGELOG_LATEST.md"
      }
    },
    "build:pinned": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{projectRoot}/config/**/*",
        {
          "env": "PINNED_CORE_DIR"
        },
        {
          "runtime": "node packages/loading-scripts/config/pinned-core.mjs"
        }
      ],
      "outputs": ["{projectRoot}/dist-pinned"],
      "options": {
        "command": "npm run build:pinned",
        "cwd": "packages/loading-scripts"
      }
    }
  }
}
